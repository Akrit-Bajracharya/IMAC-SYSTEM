# Database
DATABASE_URL="postgresql://imac_user:changeme@localhost:5432/imac_db"

# Server
PORT=3001
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=https://localhost

# Security — generate with: openssl rand -hex 32
SESSION_SECRET=replace_with_64_char_hex_secret
SESSION_COOKIE_NAME=IMAC_SESSION

# First-run seed admin accounts — change before first run!
ADMIN1_USERNAME=boss
ADMIN1_DISPLAY_NAME=Boss
ADMIN1_PASSWORD=change_me_immediately

ADMIN2_USERNAME=akrit
ADMIN2_DISPLAY_NAME=Akrit
ADMIN2_PASSWORD=change_me_immediately

# Set to true to force admin accounts to change password on first login
ADMIN_REQUIRE_PASSWORD_CHANGE=false
