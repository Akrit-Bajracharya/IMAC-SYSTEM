generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SystemRole {
  system_admin
  hr_admin
  project_manager
  employee
  viewer
}

model User {
  id                 String           @id @default(uuid())
  username           String           @unique
  displayName        String
  passwordHash       String
  systemRole         SystemRole       @default(employee)
  isActive           Boolean          @default(true)
  mustChangePassword Boolean          @default(true)
  failedLoginCount   Int              @default(0)
  lockedUntil        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  employeeProfile    EmployeeProfile?
  sessions           Session[]
  auditLogsAsActor   AuditLog[]          @relation("AuditActor")
  availabilityStatus AvailabilityStatus?
}

model EmployeeProfile {
  id                  String    @id @default(uuid())
  userId              String    @unique
  user                User      @relation(fields: [userId], references: [id])
  employeeCode        String    @unique
  department          String?
  jobTitle            String?
  startDate           DateTime?
  standardShiftHours  Float     @default(8)
  workingDaysPerWeek  Int       @default(5)
  managerUserId       String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  workRoles           EmployeeWorkRole[]
  workLogDays         WorkLogDay[]
}

model WorkRole {
  id                 String             @id @default(uuid())
  name               String             @unique
  description        String?
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  employeeWorkRoles  EmployeeWorkRole[]
  workLogEntries     WorkLogEntry[]
}

model EmployeeWorkRole {
  id                String          @id @default(uuid())
  employeeProfileId String
  employeeProfile   EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  workRoleId        String
  workRole          WorkRole        @relation(fields: [workRoleId], references: [id], onDelete: Cascade)
  createdAt         DateTime        @default(now())

  @@unique([employeeProfileId, workRoleId])
}

model Session {
  id           String   @id
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  expiresAt    DateTime
  lastActiveAt DateTime @default(now())
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
}

model SystemSetting {
  key         String   @id
  value       String
  description String?
  updatedBy   String?
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id             String   @id @default(uuid())
  actorUserId    String?
  actor          User?    @relation("AuditActor", fields: [actorUserId], references: [id])
  action         String
  entityType     String?
  entityId       String?
  beforeSnapshot Json?
  afterSnapshot  Json?
  ipAddress      String?
  createdAt      DateTime @default(now())
}

enum Availability {
  available
  busy_in_meeting
  out_of_office
  on_leave
  working_remotely
}

model AvailabilityStatus {
  id        String       @id @default(uuid())
  userId    String       @unique
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    Availability @default(available)
  message   String?
  expiresAt DateTime?
  source    String       @default("manual")
  updatedAt DateTime     @updatedAt
}

enum WorkLogStatus {
  draft
  submitted
  approved
  rejected
}

model WorkLogDay {
  id                String          @id @default(uuid())
  employeeProfileId String
  employeeProfile   EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  date              DateTime        @db.Date
  status            WorkLogStatus   @default(draft)
  submittedAt       DateTime?
  approvedAt        DateTime?
  approvedByUserId  String?
  rejectionReason   String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  entries           WorkLogEntry[]

  @@unique([employeeProfileId, date])
}

model WorkLogEntry {
  id           String      @id @default(uuid())
  workLogDayId String
  workLogDay   WorkLogDay  @relation(fields: [workLogDayId], references: [id], onDelete: Cascade)
  workRoleId   String
  workRole     WorkRole    @relation(fields: [workRoleId], references: [id])
  hours        Float
  description  String?
  projectId    String?
  taskId       String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

